<Window x:Class="NightPad.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
        mc:Ignorable="d"
        Title="Notepad" Height="650" Width="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{StaticResource BgDarkBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        RenderOptions.ClearTypeHint="Enabled"
        BorderBrush="{StaticResource BorderDarkBrush}"
        BorderThickness="1"
        AllowDrop="True"
        Drop="Window_Drop"
        Loaded="MainWindow_Loaded"
        Activated="MainWindow_Activated"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Row 0: Clean Unified TitleBar & MenuBar -->
            <RowDefinition Height="34" />
            <!-- Row 1: External File Modification Banner (Collapsible) -->
            <RowDefinition Height="Auto" />
            <!-- Row 2: Fast Terminal-Style Quick Save Panel (Collapsible) -->
            <RowDefinition Height="Auto" />
            <!-- Row 3: Search & Replace Panel (Collapsible) -->
            <RowDefinition Height="Auto" />
            <!-- Row 4: Go To Line Panel (Collapsible) -->
            <RowDefinition Height="Auto" />
            <!-- Row 5: Main Text Editor Area & Split Markdown Preview -->
            <RowDefinition Height="*" />
            <!-- Row 6: Clean Bottom Status Bar -->
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>

        <!-- ROW 0: CLEAN UNIFIED TITLEBAR & MENU BAR -->
        <Border Grid.Row="0" Background="{StaticResource BgDarkBrush}" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Col 0: App Branding & Document Title -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Col 1: Integrated Menu (File, Edit, View, Tools) -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Col 2: Draggable Spacer -->
                    <ColumnDefinition Width="*" />
                    <!-- Col 3: Right Header Actions & Window Controls -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Col 0: Document Title / App Branding -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,6,0">
                    <TextBlock Text="📝" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="TxtWindowTitle" Text="Untitled - Notepad" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    <Border Width="1" Height="14" Background="{StaticResource BorderDarkBrush}" Margin="10,0,4,0" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Col 1: Integrated Menu Bar -->
                <Menu Grid.Column="1" Background="Transparent" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center">
                    <MenuItem Header="_File" Style="{StaticResource TopMenuItemStyle}">
                        <MenuItem Header="_New" InputGestureText="Ctrl+N" Click="MenuNew_Click" />
                        <MenuItem Header="_Open..." InputGestureText="Ctrl+O" Click="MenuOpen_Click" />
                        <MenuItem Header="_Save" InputGestureText="Ctrl+S" Click="MenuSave_Click" />
                        <MenuItem Header="Save _As (Quick)..." InputGestureText="Ctrl+Shift+S" Click="MenuSaveAsQuick_Click" />
                        <MenuItem Header="Save As (_Dialog)..." InputGestureText="Ctrl+Alt+S" Click="MenuSaveAsDialog_Click" />
                        <Separator Background="{StaticResource BorderDarkBrush}" />
                        <MenuItem Header="E_xit" InputGestureText="Alt+F4" Click="MenuExit_Click" />
                    </MenuItem>

                    <MenuItem Header="_Edit" Style="{StaticResource TopMenuItemStyle}">
                        <MenuItem Header="_Undo" InputGestureText="Ctrl+Z" Click="MenuUndo_Click" />
                        <MenuItem Header="_Redo" InputGestureText="Ctrl+Y" Click="MenuRedo_Click" />
                        <Separator Background="{StaticResource BorderDarkBrush}" />
                        <MenuItem Header="Cu_t" InputGestureText="Ctrl+X" Click="MenuCut_Click" />
                        <MenuItem Header="_Copy" InputGestureText="Ctrl+C" Click="MenuCopy_Click" />
                        <MenuItem Header="_Paste" InputGestureText="Ctrl+V" Click="MenuPaste_Click" />
                        <MenuItem Header="Delete" InputGestureText="Del" Click="MenuDelete_Click" />
                        <MenuItem Header="Select _All" InputGestureText="Ctrl+A" Click="MenuSelectAll_Click" />
                        <Separator Background="{StaticResource BorderDarkBrush}" />
                        <MenuItem Header="Open Image / Link Externally" InputGestureText="Alt+O" Click="MenuOpenLink_Click" />
                        <Separator Background="{StaticResource BorderDarkBrush}" />
                        <MenuItem Header="_Find..." InputGestureText="Ctrl+F" Click="MenuFind_Click" />
                        <MenuItem Header="Find _Next" InputGestureText="F3" Click="MenuFindNext_Click" />
                        <MenuItem Header="Find _Previous" InputGestureText="Shift+F3" Click="MenuFindPrev_Click" />
                        <MenuItem Header="_Replace..." InputGestureText="Ctrl+H" Click="MenuReplace_Click" />
                        <MenuItem Header="_Go to Line..." InputGestureText="Ctrl+G" Click="MenuGoToLine_Click" />
                        <Separator Background="{StaticResource BorderDarkBrush}" />
                        <MenuItem Header="_Duplicate Line" InputGestureText="Ctrl+D" Click="MenuDuplicateLine_Click" />
                        <MenuItem Header="Delete Line" InputGestureText="Ctrl+Shift+K" Click="MenuDeleteLine_Click" />
                        <MenuItem Header="Move Line Up" InputGestureText="Alt+Up" Click="MenuMoveLineUp_Click" />
                        <MenuItem Header="Move Line Down" InputGestureText="Alt+Down" Click="MenuMoveLineDown_Click" />
                        <MenuItem Header="Toggle Comment" InputGestureText="Ctrl+/" Click="MenuToggleComment_Click" />
                        <Separator Background="{StaticResource BorderDarkBrush}" />
                        <MenuItem Header="Time / _Date" InputGestureText="F5" Click="MenuInsertDateTime_Click" />
                        <MenuItem Header="Quick Symbols &amp; _Words..." InputGestureText="Win+Shift+W" Click="MenuQuickSymbols_Click" />
                    </MenuItem>

                    <MenuItem Header="_View" Style="{StaticResource TopMenuItemStyle}">
                        <MenuItem x:Name="MenuMarkdownPreview" Header="Markdown Live _Preview" InputGestureText="Ctrl+Shift+M" IsCheckable="True" Click="MenuMarkdownPreview_Click" />
                        <Separator Background="{StaticResource BorderDarkBrush}" />
                        <MenuItem x:Name="MenuWordWrap" Header="_Word Wrap" InputGestureText="Alt+Z" IsCheckable="True" IsChecked="True" Click="MenuWordWrap_Click" />
                        <MenuItem x:Name="MenuLineNumbers" Header="Show _Line Numbers" InputGestureText="Ctrl+Shift+L" IsCheckable="True" IsChecked="True" Click="MenuLineNumbers_Click" />
                        <MenuItem x:Name="MenuStatusBarToggle" Header="_Status Bar" IsCheckable="True" IsChecked="True" Click="MenuStatusBarToggle_Click" />
                        <Separator Background="{StaticResource BorderDarkBrush}" />
                        <MenuItem x:Name="MenuRtlDirection" Header="Right-to-Left Direction (_RTL / عربي)" InputGestureText="Ctrl+Shift+R" IsCheckable="True" Click="MenuRtlDirection_Click" />
                        <MenuItem x:Name="MenuAutoArabicDetect" Header="_Auto-Detect Arabic Direction" IsCheckable="True" IsChecked="True" Click="MenuAutoArabicDetect_Click" />
                        <Separator Background="{StaticResource BorderDarkBrush}" />
                        <MenuItem Header="Zoom _In" InputGestureText="Ctrl++" Click="MenuZoomIn_Click" />
                        <MenuItem Header="Zoom _Out" InputGestureText="Ctrl+-" Click="MenuZoomOut_Click" />
                        <MenuItem Header="_Restore Default Zoom" InputGestureText="Ctrl+0" Click="MenuZoomReset_Click" />
                        <Separator Background="{StaticResource BorderDarkBrush}" />
                        <MenuItem x:Name="MenuSyntaxParent" Header="_Syntax Highlighting" />
                    </MenuItem>

                    <MenuItem Header="_Tools" Style="{StaticResource TopMenuItemStyle}">
                        <MenuItem Header="UPPERCASE" InputGestureText="Ctrl+Shift+U" Click="MenuUpper_Click" />
                        <MenuItem Header="lowercase" InputGestureText="Ctrl+U" Click="MenuLower_Click" />
                        <MenuItem Header="Title Case" Click="MenuTitleCase_Click" />
                        <Separator Background="{StaticResource BorderDarkBrush}" />
                        <MenuItem Header="Format JSON" InputGestureText="Ctrl+Shift+J" Click="MenuFormatJson_Click" />
                        <MenuItem Header="Minify JSON" Click="MenuMinifyJson_Click" />
                        <Separator Background="{StaticResource BorderDarkBrush}" />
                        <MenuItem Header="Sort Lines Ascending" Click="MenuSortAsc_Click" />
                        <MenuItem Header="Sort Lines Descending" Click="MenuSortDesc_Click" />
                        <MenuItem Header="Remove Duplicate Lines" Click="MenuRemoveDuplicates_Click" />
                        <MenuItem Header="Remove Empty Lines" Click="MenuRemoveEmptyLines_Click" />
                        <MenuItem Header="Trim Trailing Whitespace" Click="MenuTrimWhitespace_Click" />
                        <Separator Background="{StaticResource BorderDarkBrush}" />
                        <MenuItem Header="Base64 Encode" Click="MenuBase64Encode_Click" />
                        <MenuItem Header="Base64 Decode" Click="MenuBase64Decode_Click" />
                        <MenuItem Header="URL Encode" Click="MenuUrlEncode_Click" />
                        <MenuItem Header="URL Decode" Click="MenuUrlDecode_Click" />
                        <Separator Background="{StaticResource BorderDarkBrush}" />
                        <MenuItem Header="Quick Symbols &amp; _Words..." InputGestureText="Win+Shift+W" Click="MenuQuickSymbols_Click" />
                    </MenuItem>
                </Menu>

                <!-- Col 2: Draggable Window Spacer -->
                <Grid Grid.Column="2" Background="Transparent" />

                <!-- Col 3: Right Header Actions & Window Controls -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Quick Symbols & Frequent Words Palette Button -->
                    <Button x:Name="BtnHeaderQuickSymbols" Style="{StaticResource StatusButton}" Content="🔣 Symbols" ToolTip="Quick Symbols &amp; Words (Win+Shift+W / Ctrl+.)" Padding="8,3" Margin="0,0,6,0" Foreground="{StaticResource AccentBlueBrush}" Click="MenuQuickSymbols_Click" />

                    <!-- Prominent Markdown Review / Live Preview Toggle Button -->
                    <Button x:Name="BtnHeaderMarkdownPreview" Style="{StaticResource StatusButton}" Content="👁️ Markdown Preview" ToolTip="Toggle Side-by-Side Markdown Live Preview (Ctrl+Shift+M / Alt+M)" Padding="8,3" Margin="0,0,8,0" Foreground="{StaticResource AccentBlueBrush}" Click="BtnToggleMarkdownPreview_Click" />

                    <!-- Window Control Buttons -->
                    <Button Style="{StaticResource WindowControlButton}" Content="─" Click="BtnMinimize_Click" ToolTip="Minimize" />
                    <Button x:Name="BtnMaximize" Style="{StaticResource WindowControlButton}" Content="□" Click="BtnMaximize_Click" ToolTip="Maximize" />
                    <Button Content="✕" Click="BtnClose_Click" ToolTip="Close (Alt+F4)">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource WindowControlButton}">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentRedBrush}" />
                                        <Setter Property="Foreground" Value="White" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ROW 1: EXTERNAL FILE MODIFICATION BANNER (Collapsible) -->
        <Border x:Name="ExternalChangeBanner" Grid.Row="1" Background="#2A1B14" BorderBrush="#D29922" BorderThickness="0,0,0,1" Padding="12,6" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚠️" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="TxtExternalChangeMessage" Text="File has been modified outside Notepad." Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource NightButton}" Content="🔄 Reload" FontWeight="SemiBold" Foreground="{StaticResource AccentBlueBrush}" Padding="10,2" Margin="0,0,6,0" Click="BtnReloadExternal_Click" ToolTip="Reload latest file content from disk" />
                    <Button Style="{StaticResource StatusButton}" Content="Keep Mine" Padding="8,2" Click="BtnIgnoreExternal_Click" ToolTip="Keep current editor buffer and ignore external modification" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ROW 2: FAST TERMINAL-STYLE QUICK SAVE PANEL (Collapsible) -->
        <Border x:Name="QuickSavePanel" Grid.Row="2" Background="{StaticResource BgSurfaceBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,0,0,1" Padding="10,8" Visibility="Collapsed">
            <StackPanel Orientation="Vertical">
                <!-- Top Row: Label, Path Input, Action Buttons -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Save Label / Prompt -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock Text="💾" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Save As / حفظ:" FontWeight="SemiBold" Foreground="{StaticResource AccentBlueBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Keyboard Path Input with Auto-completion -->
                    <TextBox x:Name="TxtQuickSavePath" Grid.Column="1" Height="26" FontFamily="Cascadia Code, Consolas, Segoe UI" FontSize="12" VerticalContentAlignment="Center" KeyDown="TxtQuickSavePath_KeyDown" TextChanged="TxtQuickSavePath_TextChanged" PreviewKeyDown="TxtQuickSavePath_PreviewKeyDown" />

                    <!-- Actions -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                        <Button Style="{StaticResource NightButton}" Content="Save (Enter)" FontWeight="SemiBold" Foreground="{StaticResource AccentBlueBrush}" Padding="10,2" Margin="0,0,4,0" Click="BtnQuickSaveConfirm_Click" />
                        <Button Style="{StaticResource NightButton}" Content="Browse..." ToolTip="Open classic Windows Save Dialog (Alt+B)" Padding="8,2" Margin="0,0,4,0" Click="BtnQuickSaveBrowse_Click" />
                        <Button Style="{StaticResource StatusButton}" Content="Cancel (Esc)" Padding="6,2" Click="BtnQuickSaveCancel_Click" />
                    </StackPanel>
                </Grid>

                <!-- Bottom Row: Quick Preset Chips & Real-time Path Status -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Preset Folder Buttons -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Quick Jump:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <Button Style="{StaticResource StatusButton}" Content="📁 Current [F1]" FontSize="11" Margin="0,0,4,0" Click="BtnPresetCurrent_Click" ToolTip="Save to Current Directory (F1)" />
                        <Button Style="{StaticResource StatusButton}" Content="📁 Documents [F2]" FontSize="11" Margin="0,0,4,0" Click="BtnPresetDocuments_Click" ToolTip="Save to Documents (F2)" />
                        <Button Style="{StaticResource StatusButton}" Content="📁 Desktop [F3]" FontSize="11" Margin="0,0,4,0" Click="BtnPresetDesktop_Click" ToolTip="Save to Desktop (F3)" />
                        <Button Style="{StaticResource StatusButton}" Content="📁 MyEnv [F4]" FontSize="11" Click="BtnPresetMyEnv_Click" ToolTip="Save to MyEnv (F4)" />
                    </StackPanel>

                    <!-- Real-time Status / Auto-complete Hint -->
                    <TextBlock x:Name="LblQuickSaveStatus" Grid.Column="1" Text="Press Tab to autocomplete path | Enter to save" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontStyle="Italic" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- ROW 3: SEARCH & REPLACE PANEL (Collapsible) -->
        <Border x:Name="SearchPanel" Grid.Row="3" Background="{StaticResource BgSurfaceBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,0,0,1" Padding="8,5" Visibility="Collapsed">
            <StackPanel Orientation="Vertical">
                <!-- Find Row -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Find:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBox x:Name="TxtSearch" Grid.Column="1" Height="24" TextChanged="TxtSearch_TextChanged" KeyDown="TxtSearch_KeyDown" />

                    <!-- Search Controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0">
                        <ToggleButton x:Name="ChkMatchCase" Content="Match Case" Padding="6,2" Margin="0,0,4,0" Click="SearchOption_Click" Background="{StaticResource BgDarkBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderDarkBrush}" />
                        <ToggleButton x:Name="ChkWholeWord" Content="Whole Word" Padding="6,2" Margin="0,0,4,0" Click="SearchOption_Click" Background="{StaticResource BgDarkBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderDarkBrush}" />
                        <ToggleButton x:Name="ChkRegex" Content="Regex" Padding="6,2" Margin="0,0,8,0" Click="SearchOption_Click" Background="{StaticResource BgDarkBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderDarkBrush}" />
                        
                        <Button Style="{StaticResource NightButton}" Content="Previous" ToolTip="Find Previous (Shift+F3)" Margin="0,0,4,0" Click="BtnFindPrev_Click" />
                        <Button Style="{StaticResource NightButton}" Content="Next" ToolTip="Find Next (F3 / Enter)" Margin="0,0,8,0" Click="BtnFindNext_Click" />
                        <TextBlock x:Name="LblMatchCount" Text="0 matches" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0" />
                    </StackPanel>

                    <!-- Close Search -->
                    <Button Grid.Column="3" Style="{StaticResource StatusButton}" Content="Close" Padding="6,2" Click="BtnCloseSearch_Click" />
                </Grid>

                <!-- Replace Row -->
                <Grid x:Name="ReplaceRow" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Replace:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBox x:Name="TxtReplace" Grid.Column="1" Height="24" KeyDown="TxtReplace_KeyDown" />

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                        <Button Style="{StaticResource NightButton}" Content="Replace" Margin="0,0,4,0" Click="BtnReplace_Click" />
                        <Button Style="{StaticResource NightButton}" Content="Replace All" Click="BtnReplaceAll_Click" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ROW 4: GO TO LINE PANEL (Collapsible) -->
        <Border x:Name="GoToLinePanel" Grid.Row="4" Background="{StaticResource BgSurfaceBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,0,0,1" Padding="8,4" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Go to Line:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBox x:Name="TxtGoToLine" Grid.Column="1" Height="24" KeyDown="TxtGoToLine_KeyDown" />
                <Button Grid.Column="2" Style="{StaticResource NightButton}" Content="Go" Padding="12,2" Margin="8,0,0,0" Click="BtnGoToLine_Click" />
                <Button Grid.Column="4" Style="{StaticResource StatusButton}" Content="Close" Click="BtnCloseGoToLine_Click" />
            </Grid>
        </Border>

        <!-- ROW 5: MAIN TEXT EDITOR AREA & SIDE-BY-SIDE MARKDOWN PREVIEW -->
        <Grid Grid.Row="5" Background="{StaticResource BgEditorBrush}">
            <Grid.ColumnDefinitions>
                <!-- Editor Column (Left) -->
                <ColumnDefinition x:Name="ColEditor" Width="*" MinWidth="200" />
                <!-- Splitter Column -->
                <ColumnDefinition x:Name="ColSplitter" Width="Auto" />
                <!-- Markdown Preview Column (Right) -->
                <ColumnDefinition x:Name="ColPreview" Width="0" MinWidth="0" />
            </Grid.ColumnDefinitions>

            <!-- AvalonEdit Text Editor -->
            <avalonEdit:TextEditor x:Name="MainEditor"
                                   Grid.Column="0"
                                   Background="{StaticResource BgEditorBrush}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontFamily="Cascadia Code, Segoe UI, Cairo, Tahoma, Consolas, Arial"
                                   FontSize="14"
                                   ShowLineNumbers="True"
                                   WordWrap="True"
                                   HorizontalScrollBarVisibility="Auto"
                                   VerticalScrollBarVisibility="Auto"
                                   BorderThickness="0"
                                   Padding="6,4,6,4"
                                   Loaded="MainEditor_Loaded" />

            <!-- Grid Splitter for Resizable Preview -->
            <GridSplitter x:Name="PreviewSplitter"
                          Grid.Column="1"
                          Width="4"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          Background="{StaticResource BorderDarkBrush}"
                          ShowsPreview="True"
                          Visibility="Collapsed" />

            <!-- Markdown Live Preview Container -->
            <Border x:Name="PreviewContainer"
                    Grid.Column="2"
                    Background="{StaticResource BgSurfaceBrush}"
                    BorderBrush="{StaticResource BorderDarkBrush}"
                    BorderThickness="1,0,0,0"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Preview Header Bar -->
                    <Border Grid.Row="0" Background="{StaticResource BgDarkBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,0,0,1" Padding="8,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="👁️" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Markdown Live Preview" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBlueBrush}" VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource StatusButton}" Content="✕" ToolTip="Close Preview (Ctrl+Shift+M / Alt+M)" Padding="6,2" Click="BtnClosePreview_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- FlowDocument ScrollViewer for Rendered Markdown -->
                    <FlowDocumentScrollViewer x:Name="MarkdownViewer"
                                              Grid.Row="1"
                                              Background="{StaticResource BgSurfaceBrush}"
                                              Foreground="{StaticResource TextPrimaryBrush}"
                                              HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Auto"
                                              IsToolBarVisible="False"
                                              Padding="8,6" />
                </Grid>
            </Border>
        </Grid>

        <!-- ROW 6: CLEAN BOTTOM STATUS BAR -->
        <Border x:Name="StatusBarBorder" Grid.Row="6" Background="{StaticResource BgSurfaceBrush}" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,1,0,0" Padding="8,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Left: Caret & Selection Stats -->
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <!-- Right: MD Toggle, Direction, Encoding, EOL, Language, Zoom -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left Stats -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusCaretPos" Text="Ln 1, Col 1" Margin="0,0,16,0" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock x:Name="StatusSelection" Text="" Margin="0,0,16,0" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock x:Name="StatusDocStats" Text="1 line, 0 words, 0 chars" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>

                <!-- Right Stats -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Markdown Preview Toggle Button in Status Bar -->
                    <Button x:Name="BtnStatusMarkdownPreview" Style="{StaticResource StatusButton}" Content="👁️ MD Preview" ToolTip="Toggle Markdown Live Preview (Ctrl+Shift+M / Alt+M)" Margin="0,0,12,0" Foreground="{StaticResource AccentBlueBrush}" Click="BtnToggleMarkdownPreview_Click" />

                    <!-- Text Direction Toggle Button (LTR / RTL) -->
                    <Button x:Name="BtnDirectionToggle" Style="{StaticResource StatusButton}" Content="LTR" ToolTip="Text Direction: Left-To-Right (Click or press Ctrl+Shift+R to toggle RTL / عربي)" Margin="0,0,12,0" Foreground="{StaticResource AccentBlueBrush}" Click="BtnToggleDirection_Click" />

                    <!-- Zoom Level -->
                    <TextBlock x:Name="StatusZoom" Text="100%" Margin="0,0,16,0" Foreground="{StaticResource TextSecondaryBrush}" Cursor="Hand" MouseLeftButtonDown="StatusZoom_MouseLeftButtonDown" ToolTip="Click to reset zoom" />

                    <!-- Line Ending -->
                    <TextBlock x:Name="StatusEol" Text="Windows (CRLF)" Margin="0,0,16,0" Foreground="{StaticResource TextSecondaryBrush}" />

                    <!-- Encoding -->
                    <TextBlock x:Name="StatusEncoding" Text="UTF-8" Margin="0,0,16,0" Foreground="{StaticResource TextSecondaryBrush}" />

                    <!-- Language Syntax Selector -->
                    <Button x:Name="BtnLanguageSelector" Style="{StaticResource StatusButton}" Content="Plain Text" Foreground="{StaticResource AccentBlueBrush}" Padding="4,1" Click="BtnLanguageSelector_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- MODAL OVERLAY: QUICK SYMBOLS & FREQUENT WORDS PALETTE -->
        <Grid x:Name="QuickSymbolsOverlay" Grid.Row="0" Grid.RowSpan="7" Background="#B805080C" Visibility="Collapsed" Panel.ZIndex="1000" MouseDown="QuickSymbolsOverlay_MouseDown">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="580" MaxHeight="520" Background="{StaticResource BgSurfaceBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="14" MouseDown="QuickSymbolsCard_MouseDown">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="25" ShadowDepth="4" Opacity="0.65" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Row 0: Header & Close button -->
                        <RowDefinition Height="Auto" />
                        <!-- Row 1: Search and Add input row -->
                        <RowDefinition Height="Auto" />
                        <!-- Row 2: Category Filter Chips -->
                        <RowDefinition Height="Auto" />
                        <!-- Row 3: Symbols & Words List -->
                        <RowDefinition Height="*" MaxHeight="300" />
                        <!-- Row 4: Keyboard Hints & Actions Footer -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Row 0: Dialog Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🔣" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Quick Symbols &amp; Words" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="— رموز وكلمات سريعة" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Style="{StaticResource StatusButton}" Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="6,2" FontSize="12" Click="BtnCloseQuickSymbols_Click" ToolTip="Close (Esc)" />
                    </Grid>

                    <!-- Row 1: Search Box + Quick Add Button -->
                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtQuickSymbolSearch" Grid.Column="0" Height="28" FontFamily="Segoe UI, Cascadia Code, Arial" FontSize="13" VerticalContentAlignment="Center" Padding="8,2" TextChanged="TxtQuickSymbolSearch_TextChanged" PreviewKeyDown="TxtQuickSymbolSearch_PreviewKeyDown" />
                        <Button x:Name="BtnAddQuickSymbol" Grid.Column="1" Style="{StaticResource NightButton}" Content="➕ Add (Ctrl+Enter)" Margin="8,0,0,0" Padding="10,2" FontWeight="SemiBold" Foreground="{StaticResource AccentBlueBrush}" Click="BtnAddQuickSymbol_Click" ToolTip="Add typed symbol/word to list (Ctrl+Enter)" />
                    </Grid>

                    <!-- Row 2: Category Filter Chips -->
                    <WrapPanel x:Name="CategoryFilterPanel" Grid.Row="2" Margin="0,0,0,8" />

                    <!-- Row 3: Symbols & Words ListBox -->
                    <ListBox x:Name="LstQuickSymbols" Grid.Row="3" Background="{StaticResource BgEditorBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" Foreground="{StaticResource TextPrimaryBrush}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" SelectionMode="Single" MinHeight="160" MaxHeight="300" KeyDown="LstQuickSymbols_KeyDown" MouseDoubleClick="LstQuickSymbols_MouseDoubleClick">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="8,5" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4" Margin="2,1">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource BgSurfaceActiveBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource BgSurfaceHoverBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="65" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <!-- Symbol / Text Display -->
                                    <TextBlock Grid.Column="0" Text="{Binding Text}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource AccentBlueBrush}" VerticalAlignment="Center" Margin="0,0,12,0" TextTrimming="CharacterEllipsis" />
                                    <!-- Label / Description -->
                                    <TextBlock Grid.Column="1" Text="{Binding Label}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <!-- Category Tag -->
                                    <Border Grid.Column="2" Background="{StaticResource BgSurfaceHoverBrush}" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="3" Padding="5,1" Margin="8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Category}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </Border>
                                    <!-- Delete Button -->
                                    <Button Grid.Column="3" Style="{StaticResource StatusButton}" Content="✕" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Padding="4,1" Margin="4,0,0,0" VerticalAlignment="Center" Click="BtnDeleteQuickSymbol_Click" Tag="{Binding}" ToolTip="Delete this symbol/word (Del)" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Row 4: Shortcuts Footer -->
                    <Grid Grid.Row="4" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="↵ Enter:" FontWeight="SemiBold" Foreground="{StaticResource AccentBlueBrush}" Margin="0,0,3,0" />
                            <TextBlock Text="Insert" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,12,0" />
                            <TextBlock Text="Ctrl+↵:" FontWeight="SemiBold" Foreground="{StaticResource AccentBlueBrush}" Margin="0,0,3,0" />
                            <TextBlock Text="Add" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,12,0" />
                            <TextBlock Text="Del:" FontWeight="SemiBold" Foreground="{StaticResource AccentBlueBrush}" Margin="0,0,3,0" />
                            <TextBlock Text="Delete" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,12,0" />
                            <TextBlock Text="Esc:" FontWeight="SemiBold" Foreground="{StaticResource AccentBlueBrush}" Margin="0,0,3,0" />
                            <TextBlock Text="Close" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock x:Name="TxtQuickSymbolsCount" Text="0 items" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
