<Window x:Class="NightPad.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
        mc:Ignorable="d"
        Title="Notepad" Height="650" Width="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{StaticResource BgDarkBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        RenderOptions.ClearTypeHint="Enabled"
        BorderBrush="{StaticResource BorderDarkBrush}"
        BorderThickness="1"
        AllowDrop="True"
        Drop="Window_Drop"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Row 0: Clean Window TitleBar -->
            <RowDefinition Height="32" />
            <!-- Row 1: Classic Menu Bar (File, Edit, View, Tools) -->
            <RowDefinition Height="28" />
            <!-- Row 2: Search & Replace Panel (Collapsible) -->
            <RowDefinition Height="Auto" />
            <!-- Row 3: Go To Line Panel (Collapsible) -->
            <RowDefinition Height="Auto" />
            <!-- Row 4: Main Text Editor Area -->
            <RowDefinition Height="*" />
            <!-- Row 5: Clean Bottom Status Bar -->
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>

        <!-- ROW 0: CLEAN WINDOW TITLEBAR -->
        <Border Grid.Row="0" Background="{StaticResource BgDarkBrush}" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Window Title -->
                    <ColumnDefinition Width="*" />
                    <!-- Window Controls (Min, Max, Close) -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Document Title -->
                <TextBlock x:Name="TxtWindowTitle" Grid.Column="0" Text="Untitled - Notepad" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="12,0,0,0" />

                <!-- Window Controls -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource WindowControlButton}" Content="─" Click="BtnMinimize_Click" ToolTip="Minimize" />
                    <Button x:Name="BtnMaximize" Style="{StaticResource WindowControlButton}" Content="□" Click="BtnMaximize_Click" ToolTip="Maximize" />
                    <Button Content="✕" Click="BtnClose_Click" ToolTip="Close (Alt+F4)">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource WindowControlButton}">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentRedBrush}" />
                                        <Setter Property="Foreground" Value="White" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ROW 1: CLEAN MENU BAR (File, Edit, View, Tools) -->
        <Border Grid.Row="1" Background="{StaticResource BgSurfaceBrush}" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1">
            <Menu Background="Transparent" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="4,0">
                <MenuItem Header="_File" Style="{StaticResource TopMenuItemStyle}">
                    <MenuItem Header="_New" InputGestureText="Ctrl+N" Click="MenuNew_Click" />
                    <MenuItem Header="_Open..." InputGestureText="Ctrl+O" Click="MenuOpen_Click" />
                    <MenuItem Header="_Save" InputGestureText="Ctrl+S" Click="MenuSave_Click" />
                    <MenuItem Header="Save _As..." InputGestureText="Ctrl+Shift+S" Click="MenuSaveAs_Click" />
                    <Separator Background="{StaticResource BorderDarkBrush}" />
                    <MenuItem Header="E_xit" InputGestureText="Alt+F4" Click="MenuExit_Click" />
                </MenuItem>

                <MenuItem Header="_Edit" Style="{StaticResource TopMenuItemStyle}">
                    <MenuItem Header="_Undo" InputGestureText="Ctrl+Z" Click="MenuUndo_Click" />
                    <MenuItem Header="_Redo" InputGestureText="Ctrl+Y" Click="MenuRedo_Click" />
                    <Separator Background="{StaticResource BorderDarkBrush}" />
                    <MenuItem Header="Cu_t" InputGestureText="Ctrl+X" Click="MenuCut_Click" />
                    <MenuItem Header="_Copy" InputGestureText="Ctrl+C" Click="MenuCopy_Click" />
                    <MenuItem Header="_Paste" InputGestureText="Ctrl+V" Click="MenuPaste_Click" />
                    <MenuItem Header="Delete" InputGestureText="Del" Click="MenuDelete_Click" />
                    <MenuItem Header="Select _All" InputGestureText="Ctrl+A" Click="MenuSelectAll_Click" />
                    <Separator Background="{StaticResource BorderDarkBrush}" />
                    <MenuItem Header="_Find..." InputGestureText="Ctrl+F" Click="MenuFind_Click" />
                    <MenuItem Header="Find _Next" InputGestureText="F3" Click="MenuFindNext_Click" />
                    <MenuItem Header="Find _Previous" InputGestureText="Shift+F3" Click="MenuFindPrev_Click" />
                    <MenuItem Header="_Replace..." InputGestureText="Ctrl+H" Click="MenuReplace_Click" />
                    <MenuItem Header="_Go to Line..." InputGestureText="Ctrl+G" Click="MenuGoToLine_Click" />
                    <Separator Background="{StaticResource BorderDarkBrush}" />
                    <MenuItem Header="_Duplicate Line" InputGestureText="Ctrl+D" Click="MenuDuplicateLine_Click" />
                    <MenuItem Header="Delete Line" InputGestureText="Ctrl+Shift+K" Click="MenuDeleteLine_Click" />
                    <MenuItem Header="Move Line Up" InputGestureText="Alt+Up" Click="MenuMoveLineUp_Click" />
                    <MenuItem Header="Move Line Down" InputGestureText="Alt+Down" Click="MenuMoveLineDown_Click" />
                    <MenuItem Header="Toggle Comment" InputGestureText="Ctrl+/" Click="MenuToggleComment_Click" />
                    <Separator Background="{StaticResource BorderDarkBrush}" />
                    <MenuItem Header="Time / _Date" InputGestureText="F5" Click="MenuInsertDateTime_Click" />
                </MenuItem>

                <MenuItem Header="_View" Style="{StaticResource TopMenuItemStyle}">
                    <MenuItem x:Name="MenuWordWrap" Header="_Word Wrap" InputGestureText="Alt+Z" IsCheckable="True" Click="MenuWordWrap_Click" />
                    <MenuItem x:Name="MenuLineNumbers" Header="Show _Line Numbers" InputGestureText="Ctrl+Shift+L" IsCheckable="True" IsChecked="True" Click="MenuLineNumbers_Click" />
                    <MenuItem x:Name="MenuStatusBarToggle" Header="_Status Bar" IsCheckable="True" IsChecked="True" Click="MenuStatusBarToggle_Click" />
                    <Separator Background="{StaticResource BorderDarkBrush}" />
                    <MenuItem Header="Zoom _In" InputGestureText="Ctrl++" Click="MenuZoomIn_Click" />
                    <MenuItem Header="Zoom _Out" InputGestureText="Ctrl+-" Click="MenuZoomOut_Click" />
                    <MenuItem Header="_Restore Default Zoom" InputGestureText="Ctrl+0" Click="MenuZoomReset_Click" />
                    <Separator Background="{StaticResource BorderDarkBrush}" />
                    <MenuItem x:Name="MenuSyntaxParent" Header="_Syntax Highlighting" />
                </MenuItem>

                <MenuItem Header="_Tools" Style="{StaticResource TopMenuItemStyle}">
                    <MenuItem Header="UPPERCASE" InputGestureText="Ctrl+Shift+U" Click="MenuUpper_Click" />
                    <MenuItem Header="lowercase" InputGestureText="Ctrl+U" Click="MenuLower_Click" />
                    <MenuItem Header="Title Case" Click="MenuTitleCase_Click" />
                    <Separator Background="{StaticResource BorderDarkBrush}" />
                    <MenuItem Header="Format JSON" InputGestureText="Ctrl+Shift+J" Click="MenuFormatJson_Click" />
                    <MenuItem Header="Minify JSON" Click="MenuMinifyJson_Click" />
                    <Separator Background="{StaticResource BorderDarkBrush}" />
                    <MenuItem Header="Sort Lines Ascending" Click="MenuSortAsc_Click" />
                    <MenuItem Header="Sort Lines Descending" Click="MenuSortDesc_Click" />
                    <MenuItem Header="Remove Duplicate Lines" Click="MenuRemoveDuplicates_Click" />
                    <MenuItem Header="Remove Empty Lines" Click="MenuRemoveEmptyLines_Click" />
                    <MenuItem Header="Trim Trailing Whitespace" Click="MenuTrimWhitespace_Click" />
                    <Separator Background="{StaticResource BorderDarkBrush}" />
                    <MenuItem Header="Base64 Encode" Click="MenuBase64Encode_Click" />
                    <MenuItem Header="Base64 Decode" Click="MenuBase64Decode_Click" />
                    <MenuItem Header="URL Encode" Click="MenuUrlEncode_Click" />
                    <MenuItem Header="URL Decode" Click="MenuUrlDecode_Click" />
                </MenuItem>
            </Menu>
        </Border>

        <!-- ROW 2: SEARCH & REPLACE PANEL (Collapsible) -->
        <Border x:Name="SearchPanel" Grid.Row="2" Background="{StaticResource BgSurfaceBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,0,0,1" Padding="8,5" Visibility="Collapsed">
            <StackPanel Orientation="Vertical">
                <!-- Find Row -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Find:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBox x:Name="TxtSearch" Grid.Column="1" Height="24" TextChanged="TxtSearch_TextChanged" KeyDown="TxtSearch_KeyDown" />

                    <!-- Search Controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0">
                        <ToggleButton x:Name="ChkMatchCase" Content="Match Case" Padding="6,2" Margin="0,0,4,0" Click="SearchOption_Click" Background="{StaticResource BgDarkBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderDarkBrush}" />
                        <ToggleButton x:Name="ChkWholeWord" Content="Whole Word" Padding="6,2" Margin="0,0,4,0" Click="SearchOption_Click" Background="{StaticResource BgDarkBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderDarkBrush}" />
                        <ToggleButton x:Name="ChkRegex" Content="Regex" Padding="6,2" Margin="0,0,8,0" Click="SearchOption_Click" Background="{StaticResource BgDarkBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderDarkBrush}" />
                        
                        <Button Style="{StaticResource NightButton}" Content="Previous" ToolTip="Find Previous (Shift+F3)" Margin="0,0,4,0" Click="BtnFindPrev_Click" />
                        <Button Style="{StaticResource NightButton}" Content="Next" ToolTip="Find Next (F3 / Enter)" Margin="0,0,8,0" Click="BtnFindNext_Click" />
                        <TextBlock x:Name="LblMatchCount" Text="0 matches" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0" />
                    </StackPanel>

                    <!-- Close Search -->
                    <Button Grid.Column="3" Style="{StaticResource StatusButton}" Content="Close" Padding="6,2" Click="BtnCloseSearch_Click" />
                </Grid>

                <!-- Replace Row -->
                <Grid x:Name="ReplaceRow" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Replace:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBox x:Name="TxtReplace" Grid.Column="1" Height="24" KeyDown="TxtReplace_KeyDown" />

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                        <Button Style="{StaticResource NightButton}" Content="Replace" Margin="0,0,4,0" Click="BtnReplace_Click" />
                        <Button Style="{StaticResource NightButton}" Content="Replace All" Click="BtnReplaceAll_Click" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ROW 3: GO TO LINE PANEL (Collapsible) -->
        <Border x:Name="GoToLinePanel" Grid.Row="3" Background="{StaticResource BgSurfaceBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,0,0,1" Padding="8,4" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Go to Line:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBox x:Name="TxtGoToLine" Grid.Column="1" Height="24" KeyDown="TxtGoToLine_KeyDown" />
                <Button Grid.Column="2" Style="{StaticResource NightButton}" Content="Go" Padding="12,2" Margin="8,0,0,0" Click="BtnGoToLine_Click" />
                <Button Grid.Column="4" Style="{StaticResource StatusButton}" Content="Close" Click="BtnCloseGoToLine_Click" />
            </Grid>
        </Border>

        <!-- ROW 4: MAIN TEXT EDITOR AREA -->
        <Grid Grid.Row="4" Background="{StaticResource BgEditorBrush}">
            <avalonEdit:TextEditor x:Name="MainEditor"
                                   Background="{StaticResource BgEditorBrush}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontFamily="Cascadia Code, JetBrains Mono, Consolas, Courier New"
                                   FontSize="14"
                                   ShowLineNumbers="True"
                                   WordWrap="False"
                                   HorizontalScrollBarVisibility="Auto"
                                   VerticalScrollBarVisibility="Auto"
                                   BorderThickness="0"
                                   Padding="6,4,6,4" />
        </Grid>

        <!-- ROW 5: CLEAN BOTTOM STATUS BAR -->
        <Border x:Name="StatusBarBorder" Grid.Row="5" Background="{StaticResource BgSurfaceBrush}" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,1,0,0" Padding="8,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Left: Caret & Selection Stats -->
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <!-- Right: Encoding, EOL, Language, Zoom -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left Stats -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusCaretPos" Text="Ln 1, Col 1" Margin="0,0,16,0" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock x:Name="StatusSelection" Text="" Margin="0,0,16,0" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock x:Name="StatusDocStats" Text="1 line, 0 words, 0 chars" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>

                <!-- Right Stats -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Zoom Level -->
                    <TextBlock x:Name="StatusZoom" Text="100%" Margin="0,0,16,0" Foreground="{StaticResource TextSecondaryBrush}" Cursor="Hand" MouseLeftButtonDown="StatusZoom_MouseLeftButtonDown" ToolTip="Click to reset zoom" />

                    <!-- Line Ending -->
                    <TextBlock x:Name="StatusEol" Text="Windows (CRLF)" Margin="0,0,16,0" Foreground="{StaticResource TextSecondaryBrush}" />

                    <!-- Encoding -->
                    <TextBlock x:Name="StatusEncoding" Text="UTF-8" Margin="0,0,16,0" Foreground="{StaticResource TextSecondaryBrush}" />

                    <!-- Language Syntax Selector -->
                    <Button x:Name="BtnLanguageSelector" Style="{StaticResource StatusButton}" Content="Plain Text" Foreground="{StaticResource AccentBlueBrush}" Padding="4,1" Click="BtnLanguageSelector_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
