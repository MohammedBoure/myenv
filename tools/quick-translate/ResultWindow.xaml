<Window x:Class="QuickTranslate.ResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuickTranslate Result"
        SizeToContent="Height" Width="460"
        WindowStyle="None"
        AllowsTransparency="True"
        Topmost="True"
        ShowInTaskbar="False"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown"
        MouseDown="Window_MouseDown">
    
    <!-- Sharp Black Obsidian Container (0px Radius matching YASB/Zebar myenv theme) -->
    <Border Background="#0E0E0E"
            BorderBrush="#373737"
            BorderThickness="1"
            CornerRadius="0"
            Padding="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.8"/>
        </Border.Effect>
        
        <StackPanel>
            <!-- Minimal Sharp Header Bar -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚡ ترجمة سريعة" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold" FontFamily="Segoe UI, Tahoma"/>
                    <Border x:Name="LangBadge" Background="#1F1F1F" BorderBrush="#373737" BorderThickness="1" CornerRadius="0" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtLangBadge" Text="EN ➔ AR" Foreground="#F5F5F5" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
                
                <Button Grid.Column="1" Content="✕" Click="BtnClose_Click"
                        Foreground="#888888" Background="Transparent" BorderThickness="0"
                        FontSize="13" FontWeight="Bold" Width="24" Height="24" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="0">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="#FF5555"/>
                                    <Setter Property="Background" Value="#1A1A1A"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <!-- Editable Arabic Translation Box (Sharp Edges, Black Theme) -->
            <Border Background="#141414" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="0" Padding="10,8" Margin="0,0,0,8">
                <TextBox x:Name="TxtTranslation"
                         Foreground="#FFFFFF"
                         CaretBrush="#FFFFFF"
                         FontSize="16"
                         FontWeight="SemiBold"
                         FontFamily="Segoe UI, Tahoma, Arial"
                         FlowDirection="RightToLeft"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         IsReadOnly="False"
                         BorderThickness="0"
                         Background="Transparent"
                         MaxHeight="250"
                         VerticalScrollBarVisibility="Auto"
                         TextChanged="TxtTranslation_TextChanged"/>
            </Border>

            <!-- Editable Original Text Box (Sharp Edges) -->
            <Border Background="#141414" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="0" Padding="8,6" Margin="0,0,0,0">
                <TextBox x:Name="TxtOriginal"
                         Foreground="#A0A0A0"
                         CaretBrush="#A0A0A0"
                         FontSize="12"
                         FontFamily="Consolas, Segoe UI"
                         FlowDirection="LeftToRight"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         IsReadOnly="False"
                         BorderThickness="0"
                         Background="Transparent"
                         MaxHeight="60"
                         VerticalScrollBarVisibility="Auto"
                         TextChanged="TxtOriginal_TextChanged"/>
            </Border>
        </StackPanel>
    </Border>
</Window>
