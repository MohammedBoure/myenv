<Window x:Class="QuickTranslate.TypeTranslateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuickTranslate - اكتب وترجم"
        Width="590" SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Topmost="True"
        ShowInTaskbar="False"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        KeyDown="Window_KeyDown"
        MouseDown="Window_MouseDown">

    <!-- Sharp Obsidian Container (0px Radius matching YASB/Zebar/GlazeWM myenv theme) -->
    <Border Background="#0E0E0E"
            BorderBrush="#373737"
            BorderThickness="1"
            CornerRadius="0"
            Padding="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Direction="270" Color="#000000" Opacity="0.85"/>
        </Border.Effect>

        <StackPanel>
            <!-- Minimal Sharp Header Bar -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚡" Foreground="#00D8FF" FontSize="14" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="اكتب وترجم وطبق فوراً" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold" FontFamily="Segoe UI, Tahoma" VerticalAlignment="Center"/>
                    
                    <!-- Language Direction Switch Button (Tab to toggle) -->
                    <Button x:Name="BtnLangToggle" Click="BtnLangToggle_Click" Background="#1A1A1A" BorderBrush="#373737" BorderThickness="1" Cursor="Hand" Margin="10,0,0,0" Padding="8,2" ToolTip="اضغط هنا أو اضغط Tab للتبديل بين اللغات">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="0" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#252525"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TxtLangDirection" Text="تلقائي (AR ⇄ EN)" Foreground="#00E5FF" FontSize="11" FontWeight="Bold" FontFamily="Consolas, Segoe UI"/>
                            <TextBlock Text=" ⇥" Foreground="#888888" FontSize="10" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <TextBlock x:Name="TxtStatus" Text="جاهز" Foreground="#888888" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Close Button -->
                <Button Grid.Column="1" Content="✕" Click="BtnClose_Click"
                        Foreground="#888888" Background="Transparent" BorderThickness="0"
                        FontSize="13" FontWeight="Bold" Width="24" Height="24" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="0">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="#FF5555"/>
                                    <Setter Property="Background" Value="#1F1F1F"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <!-- Input Box Section -->
            <Border Background="#141414" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="0" Padding="10,8" Margin="0,0,0,10">
                <Grid>
                    <!-- Placeholder Text -->
                    <TextBlock x:Name="TxtPlaceholder"
                               Text="اكتب النص هنا مباشرة... (سيتم ترجمته وتطبيقه فوراً عند ضغط Enter)"
                               Foreground="#555555"
                               FontSize="15"
                               FontFamily="Segoe UI, Tahoma"
                               FlowDirection="RightToLeft"
                               IsHitTestVisible="False"
                               VerticalAlignment="Top"
                               Margin="2,2,0,0"/>

                    <!-- Main Input TextBox -->
                    <TextBox x:Name="TxtInput"
                             Foreground="#FFFFFF"
                             CaretBrush="#00E5FF"
                             FontSize="15"
                             FontFamily="Segoe UI, Tahoma, Arial"
                             FlowDirection="RightToLeft"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             BorderThickness="0"
                             Background="Transparent"
                             MaxHeight="120"
                             VerticalScrollBarVisibility="Auto"
                             TextChanged="TxtInput_TextChanged"
                             PreviewKeyDown="TxtInput_PreviewKeyDown"/>
                </Grid>
            </Border>

            <!-- Translation Preview Section -->
            <Border Background="#161616" BorderBrush="#282828" BorderThickness="1" CornerRadius="0" Padding="10,8" Margin="0,0,0,12">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="المعاينة المترجمة (سيتم تطبيقها ولصقها تلقائياً):" Foreground="#777777" FontSize="11" FontWeight="SemiBold" FontFamily="Segoe UI, Tahoma"/>
                        <TextBlock x:Name="TxtLiveIndicator" Text="⚡ مباشر" Foreground="#00E5FF" FontSize="11" HorizontalAlignment="Right"/>
                    </Grid>
                    
                    <TextBox x:Name="TxtTranslation"
                             Foreground="#4FC3F7"
                             CaretBrush="#4FC3F7"
                             FontSize="15"
                             FontWeight="SemiBold"
                             FontFamily="Segoe UI, Consolas, Arial"
                             FlowDirection="LeftToRight"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             BorderThickness="0"
                             Background="Transparent"
                             MaxHeight="140"
                             VerticalScrollBarVisibility="Auto"
                             TextChanged="TxtTranslation_TextChanged"/>
                </StackPanel>
            </Border>

            <!-- Footer Action Bar & Shortcuts Guide -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Hotkey Tips -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#1A1A1A" BorderBrush="#333333" BorderThickness="1" Padding="4,1" Margin="0,0,4,0">
                        <TextBlock Text="↵ Enter لصق" Foreground="#AAAAAA" FontSize="10"/>
                    </Border>
                    <Border Background="#1A1A1A" BorderBrush="#333333" BorderThickness="1" Padding="4,1" Margin="0,0,4,0">
                        <TextBlock Text="⇥ Tab تبديل اللغة" Foreground="#AAAAAA" FontSize="10"/>
                    </Border>
                    <Border Background="#1A1A1A" BorderBrush="#333333" BorderThickness="1" Padding="4,1" Margin="0,0,4,0">
                        <TextBlock Text="Esc إلغاء" Foreground="#AAAAAA" FontSize="10"/>
                    </Border>
                    <Border Background="#1A1A1A" BorderBrush="#333333" BorderThickness="1" Padding="4,1">
                        <TextBlock Text="⇧↵ سطر جديد" Foreground="#AAAAAA" FontSize="10"/>
                    </Border>
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="نسخ فقط" Click="BtnCopyOnly_Click"
                            Foreground="#CCCCCC" Background="#1A1A1A" BorderBrush="#373737" BorderThickness="1"
                            FontSize="11" FontWeight="SemiBold" Padding="10,4" Margin="0,0,6,0" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="0" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#282828"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="تطبيق ولصق ↵" Click="BtnApply_Click"
                            Foreground="#FFFFFF" Background="#0078D4" BorderThickness="0"
                            FontSize="11" FontWeight="Bold" Padding="12,4" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="0" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#1084D9"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</Window>
