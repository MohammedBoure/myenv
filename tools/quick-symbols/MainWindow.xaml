<Window x:Class="QuickSymbols.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quick Symbols &amp; Words" Height="500" Width="580"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Loaded="Window_Loaded"
        KeyDown="Window_KeyDown">

    <Border Background="{StaticResource BgSurfaceBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="25" ShadowDepth="4" Opacity="0.65" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <!-- Row 0: Header & Close button -->
                <RowDefinition Height="Auto" />
                <!-- Row 1: Search and Add input row -->
                <RowDefinition Height="Auto" />
                <!-- Row 2: Category Filter Chips -->
                <RowDefinition Height="Auto" />
                <!-- Row 3: Symbols & Words List -->
                <RowDefinition Height="*" />
                <!-- Row 4: Keyboard Hints & Actions Footer -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Row 0: Dialog Header -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🔣" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="Quick Symbols &amp; Words" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="— رموز وكلمات سريعة (Win+Shift+W)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <Button Style="{StaticResource StatusButton}" Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="6,2" FontSize="12" Click="BtnClose_Click" ToolTip="Close (Esc)" />
            </Grid>

            <!-- Row 1: Search Box + Quick Add Button -->
            <Grid Grid.Row="1" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtQuickSymbolSearch" Grid.Column="0" Height="28" FontFamily="Segoe UI, Cascadia Code, Arial" FontSize="13" VerticalContentAlignment="Center" Padding="8,2" TextChanged="TxtQuickSymbolSearch_TextChanged" PreviewKeyDown="TxtQuickSymbolSearch_PreviewKeyDown" />
                <Button x:Name="BtnAddQuickSymbol" Grid.Column="1" Style="{StaticResource NightButton}" Content="➕ Add (Ctrl+Enter)" Margin="8,0,0,0" Padding="10,2" FontWeight="SemiBold" Foreground="{StaticResource AccentBlueBrush}" Click="BtnAddQuickSymbol_Click" ToolTip="Add typed symbol/word to list (Ctrl+Enter)" />
            </Grid>

            <!-- Row 2: Category Filter Chips -->
            <WrapPanel x:Name="CategoryFilterPanel" Grid.Row="2" Margin="0,0,0,8" />

            <!-- Row 3: Symbols & Words ListBox -->
            <ListBox x:Name="LstQuickSymbols" Grid.Row="3" Background="{StaticResource BgDarkBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" Foreground="{StaticResource TextPrimaryBrush}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" SelectionMode="Single" MinHeight="160" MaxHeight="300" KeyDown="LstQuickSymbols_KeyDown" MouseDoubleClick="LstQuickSymbols_MouseDoubleClick">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="8,5" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4" Margin="2,1">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource BgSurfaceActiveBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource BgSurfaceHoverBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="65" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- Symbol / Text Display -->
                            <TextBlock Grid.Column="0" Text="{Binding Text}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource AccentBlueBrush}" VerticalAlignment="Center" Margin="0,0,12,0" TextTrimming="CharacterEllipsis" />
                            <!-- Label / Description -->
                            <TextBlock Grid.Column="1" Text="{Binding Label}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <!-- Category Tag -->
                            <Border Grid.Column="2" Background="{StaticResource BgSurfaceHoverBrush}" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="3" Padding="5,1" Margin="8,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Category}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                            </Border>
                            <!-- Delete Button -->
                            <Button Grid.Column="3" Style="{StaticResource StatusButton}" Content="✕" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Padding="4,1" Margin="4,0,0,0" VerticalAlignment="Center" Click="BtnDeleteQuickSymbol_Click" Tag="{Binding}" ToolTip="Delete this symbol/word (Del)" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Row 4: Shortcuts Footer -->
            <Grid Grid.Row="4" Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="↵ Enter:" FontWeight="SemiBold" Foreground="{StaticResource AccentBlueBrush}" Margin="0,0,3,0" />
                    <TextBlock Text="Insert" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,12,0" />
                    <TextBlock Text="Ctrl+↵:" FontWeight="SemiBold" Foreground="{StaticResource AccentBlueBrush}" Margin="0,0,3,0" />
                    <TextBlock Text="Add" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,12,0" />
                    <TextBlock Text="Del:" FontWeight="SemiBold" Foreground="{StaticResource AccentBlueBrush}" Margin="0,0,3,0" />
                    <TextBlock Text="Delete" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,12,0" />
                    <TextBlock Text="Esc:" FontWeight="SemiBold" Foreground="{StaticResource AccentBlueBrush}" Margin="0,0,3,0" />
                    <TextBlock Text="Close" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
                <TextBlock x:Name="TxtQuickSymbolsCount" Text="0 items" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" />
            </Grid>
        </Grid>
    </Border>
</Window>
