# MyEnv - Clink Custom Settings for CMD
# Default File/Path Completion & F7 History Popup Configuration

# 1. Enable Real-Time Inline Auto-Suggestions & Windows Keybindings
clink.default_bindings = windows
autosuggest.enable = true
autosuggest.strategy = completion match_history
color.autosuggest = 8

# 2. Popup Completion Menu for Files, Folders & Paths
match.completion_type = popup
match.popup_limit = 15
match.ignore_case = relaxed
match.ignore_accent = true

# Enable directory & file completion
exec.dirs = true
exec.files = true
exec.commands = true
exec.path = true

# 3. Persistent History & Auto-Saving
history.save = true
history.sticky_search = true
history.dont_dedupe = false
history.ignore_space = true

# 4. Obsidian Dark Theme Colors
color.popup = default
color.popup_border = bright black
color.popup_select = black on bright white
color.popup_header = bright cyan

# 5. Direct2D Performance
terminal.d2d = true
