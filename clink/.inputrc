# MyEnv Clink Readline Configuration
# No F8 / Fn key required!

# 1. Up Arrow (↑) -> Opens Interactive Command History List Menu directly
"Up": clink-popup-history
"Down": history-search-forward

# 2. Tab Key -> File & Directory Completion Menu
"Tab": clink-completion-popup

# 3. Ctrl+Space / Ctrl+R -> Interactive Command History Menu
"Control-space": clink-popup-history
"Control-r": clink-popup-history

# 4. Standard Left & Right Arrows -> Move Cursor Character-by-Character for editing text
# (Left and Right arrows move cursor character-by-character natively)
