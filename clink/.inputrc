# MyEnv Clink Readline Configuration
# Map Ctrl+Space and Alt+H to luafunc:trigger_win_history_list (The F7 Boxed History Menu: ┌──── History ────┐)

# 1. Ctrl+Space & Alt+H bound to luafunc:trigger_win_history_list
"\C-@": "luafunc:trigger_win_history_list"
"Control-space": "luafunc:trigger_win_history_list"
"C-Space": "luafunc:trigger_win_history_list"
"\eh": "luafunc:trigger_win_history_list"

# 2. F7 key
"F7": win-history-list

# 3. Tab Key -> File, Directory & Path Completion Menu
"\t": clink-popup-complete
"Tab": clink-popup-complete

# 4. Standard Text Editing & Cursor Movement (Left and Right arrows move character-by-character natively)
