# MyEnv Clink Readline Configuration
# Dual Completion System for CMD:
# - Tab: Files, Folders & Command Completion Menu
# - Ctrl+Space / Shift+Tab / Ctrl+R / F7: Command History Popup Menu

# 1. Tab Key -> File, Folder & Directory Completion Menu
"\t": clink-completion-popup

# 2. Ctrl+Space & Shift+Tab -> Command History List Menu
"\C-@": clink-popup-history
"Control-space": clink-popup-history
"\e[Z": clink-popup-history

# 3. Ctrl+R -> Interactive Search Command History
"\C-r": clink-popup-history

# 4. F8 -> Search History Matching Typed Prefix
"\e[19~": history-search-backward
